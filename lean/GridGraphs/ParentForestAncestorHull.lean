import GridGraphs.PlaneChannelForest

/-!
# Minimal ancestor hulls in parent forests

The ancestor hull generated by selected leaves contains exactly their parent
chains.  In particular, ambient leaves and branches not lying above a selected
leaf are discarded.
-/

namespace GridGraphs

namespace ParentForest

variable {V Start : Type*} [Fintype V] [DecidableEq V]
  [Fintype Start] [DecidableEq Start]

noncomputable section

attribute [local instance] Classical.propDecidable Classical.decEq

/-- One upward step in the parent orientation. -/
def ParentStep (F : ParentForest V) (v w : V) : Prop :=
  F.parent v = some w

/-- Following a finite ranked parent map reaches a genuine root. -/
theorem exists_rootAbove (F : ParentForest V) (v : V) :
    ∃ r : V, Relation.ReflTransGen F.ParentStep v r ∧ F.parent r = none := by
  suffices h : ∀ k v, F.rank v = k →
      ∃ r, Relation.ReflTransGen F.ParentStep v r ∧ F.parent r = none by
    exact h (F.rank v) v rfl
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
      intro v hv
      cases hparent : F.parent v with
      | none => exact ⟨v, Relation.ReflTransGen.refl, hparent⟩
      | some w =>
          have hrank : F.rank w < k := by
            rw [← hv]
            exact F.rank_parent hparent
          obtain ⟨r, hwr, hr⟩ := ih (F.rank w) hrank w rfl
          exact ⟨r, Relation.ReflTransGen.head hparent hwr, hr⟩

/-- Canonically chosen root above a vertex, packaged with the complete parent
chain.  Existence follows only from rank descent. -/
noncomputable def rootAbove (F : ParentForest V) (v : V) :
    {r : V // Relation.ReflTransGen F.ParentStep v r ∧ r ∈ F.roots} := by
  let h := F.exists_rootAbove v
  let r := Classical.choose h
  exact ⟨r, (Classical.choose_spec h).1, by
    simp only [roots, Finset.mem_filter, Finset.mem_univ, true_and]
    exact (Classical.choose_spec h).2⟩

/-- Vertices on a parent chain beginning at one of the selected leaves. -/
def AncestorActive (F : ParentForest V) (start : Start ↪ ↥F.leaves) (v : V) : Prop :=
  ∃ s : Start, Relation.ReflTransGen F.ParentStep (start s).1 v

/-- Carrier of the minimal ancestor hull generated by `start`. -/
def AncestorHull (F : ParentForest V) (start : Start ↪ ↥F.leaves) :=
  {v : V // F.AncestorActive start v}

instance ancestorHullFintype (F : ParentForest V) (start : Start ↪ ↥F.leaves) :
    Fintype (F.AncestorHull start) :=
  Fintype.ofInjective Subtype.val Subtype.val_injective

omit [Fintype Start] [DecidableEq Start] in
theorem ancestorActive_parent (F : ParentForest V) (start : Start ↪ ↥F.leaves)
    {v w : V} (hv : F.AncestorActive start v) (hparent : F.parent v = some w) :
    F.AncestorActive start w := by
  obtain ⟨s, hsv⟩ := hv
  exact ⟨s, hsv.tail hparent⟩

/-- The ambient parent map restricted to the generated ancestor hull. -/
noncomputable def ancestorHullParent (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) :
    F.AncestorHull start → Option (F.AncestorHull start) := fun v =>
  match h : F.parent v.1 with
  | none => none
  | some w => some ⟨w, ancestorActive_parent F start v.2 h⟩

omit [Fintype Start] [DecidableEq Start] in
@[simp] theorem ancestorHullParent_eq_some (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v w : F.AncestorHull start) :
    F.ancestorHullParent start v = some w ↔ F.parent v.1 = some w.1 := by
  unfold ancestorHullParent
  split
  · rename_i hnone
    constructor
    · intro h
      exact Option.noConfusion h
    · intro h
      rw [hnone] at h
      exact Option.noConfusion h
  · rename_i x hparent
    constructor
    · intro h
      have hxw : (⟨x, ancestorActive_parent F start v.2 hparent⟩ :
          F.AncestorHull start) = w := Option.some.inj h
      exact hparent.trans (congrArg Option.some (congrArg Subtype.val hxw))
    · intro h
      have hxw : x = w.1 := Option.some.inj (hparent.symm.trans h)
      exact congrArg Option.some (Subtype.ext hxw)

omit [Fintype Start] [DecidableEq Start] in
@[simp] theorem ancestorHullParent_eq_none (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) :
    F.ancestorHullParent start v = none ↔ F.parent v.1 = none := by
  unfold ancestorHullParent
  split <;> simp_all

/-- The induced parent forest on all and only the selected ancestor chains. -/
noncomputable def ancestorHullForest (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) : ParentForest (F.AncestorHull start) where
  parent := F.ancestorHullParent start
  rank v := F.rank v.1
  rank_parent := by
    intro v w hparent
    exact F.rank_parent ((ancestorHullParent_eq_some F start v w).1 hparent)

/-- A selected leaf, regarded as a vertex of its generated hull. -/
noncomputable def ancestorHullStart (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) : Start ↪ F.AncestorHull start where
  toFun s := ⟨(start s).1, s, Relation.ReflTransGen.refl⟩
  inj' := by
    intro a b hab
    have hv : (start a).1 = (start b).1 :=
      congrArg (fun x : F.AncestorHull start => x.1) hab
    exact start.injective (Subtype.ext hv)

/-- Roots of the hull are exactly active ambient roots. -/
theorem mem_ancestorHullForest_roots_iff (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) :
    v ∈ (F.ancestorHullForest start).roots ↔ v.1 ∈ F.roots := by
  simp [roots, ancestorHullForest]

/-- No new root is introduced by restricting to complete parent chains. -/
theorem ancestorHullForest_parent_eq_none_iff (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) :
    (F.ancestorHullForest start).parent v = none ↔ F.parent v.1 = none := by
  exact ancestorHullParent_eq_none F start v

/-- A hull vertex is a leaf precisely when it is one of the selected starts. -/
theorem mem_ancestorHullForest_leaves_iff (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) :
    v ∈ (F.ancestorHullForest start).leaves ↔
      ∃ s : Start, v = F.ancestorHullStart start s := by
  constructor
  · intro hv
    obtain ⟨s, hsv⟩ := v.2
    rcases hsv.cases_tail with hvs | ⟨u, hsu, huv⟩
    · exact ⟨s, Subtype.ext hvs⟩
    ·
        exfalso
        have huActive : F.AncestorActive start _ := ⟨s, hsu⟩
        have huChild : (⟨_, huActive⟩ : F.AncestorHull start) ∈
            (F.ancestorHullForest start).children v := by
          simp [children, ancestorHullForest, ParentStep] at huv ⊢
          exact huv
        have hvzero : (F.ancestorHullForest start).childCount v = 0 := by
          simpa [leaves] using hv
        have : (F.ancestorHullForest start).childCount v ≠ 0 := by
          exact Finset.card_ne_zero.mpr ⟨_, huChild⟩
        exact this hvzero
  · rintro ⟨s, rfl⟩
    simp only [leaves, Finset.mem_filter, Finset.mem_univ, true_and, childCount]
    apply Finset.card_eq_zero.mpr
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro w hw
    have hwparent : F.parent w.1 = some (start s).1 := by
      exact (ancestorHullParent_eq_some F start w (F.ancestorHullStart start s)).1
        (Finset.mem_filter.mp hw).2
    have hsleaf : F.childCount (start s).1 = 0 := by
      exact (Finset.mem_filter.mp (start s).2).2
    have hwmem : w.1 ∈ F.children (start s).1 := by simp [children, hwparent]
    have hempty : F.children (start s).1 = ∅ := Finset.card_eq_zero.mp hsleaf
    rw [hempty] at hwmem
    exact Finset.notMem_empty _ hwmem

/-- The selected starts are equivalent to all leaves of the generated hull. -/
noncomputable def ancestorHullLeafEquiv (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) :
    Start ≃ ↥((F.ancestorHullForest start).leaves) :=
  Equiv.ofBijective
    (fun s => ⟨F.ancestorHullStart start s,
      (F.mem_ancestorHullForest_leaves_iff start _).2 ⟨s, rfl⟩⟩)
    ⟨by
      intro a b hab
      exact (F.ancestorHullStart start).injective
        (congrArg (fun x => x.1) hab), by
      rintro ⟨v, hv⟩
      obtain ⟨s, rfl⟩ := (F.mem_ancestorHullForest_leaves_iff start v).1 hv
      exact ⟨s, rfl⟩⟩

/-- Exact Euler ledger for a generated ancestor hull, including empty and
multi-start hulls. -/
theorem card_start_eq_card_ancestorHull_roots_add_branchExcess
    (F : ParentForest V) (start : Start ↪ ↥F.leaves) :
    Fintype.card Start = (F.ancestorHullForest start).roots.card +
      (F.ancestorHullForest start).branchExcess := by
  calc
    Fintype.card Start = Fintype.card ↥((F.ancestorHullForest start).leaves) :=
      Fintype.card_congr (F.ancestorHullLeafEquiv start)
    _ = (F.ancestorHullForest start).leaves.card := Fintype.card_coe _
    _ = (F.ancestorHullForest start).roots.card +
        (F.ancestorHullForest start).branchExcess :=
      (F.ancestorHullForest start).card_leaves_eq_card_roots_add_branchExcess

/-! ## Descendant-source labels -/

/-- Selected starts whose parent chain passes through an active hull vertex.
This is the source-provenance carried by the shared hull vertex; it does not
choose a representative start. -/
def ancestorHullDescendantSources (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) : Finset Start :=
  Finset.univ.filter fun s =>
    Relation.ReflTransGen F.ParentStep (start s).1 v.1

@[simp] theorem mem_ancestorHullDescendantSources (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) (s : Start) :
    s ∈ F.ancestorHullDescendantSources start v ↔
      Relation.ReflTransGen F.ParentStep (start s).1 v.1 := by
  simp [ancestorHullDescendantSources]

/-- Every active hull vertex retains at least one selected descendant source. -/
theorem ancestorHullDescendantSources_nonempty (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) (v : F.AncestorHull start) :
    (F.ancestorHullDescendantSources start v).Nonempty := by
  obtain ⟨s, hs⟩ := v.2
  exact ⟨s, (F.mem_ancestorHullDescendantSources start v s).2 hs⟩

/-- Descendant provenance can only grow while following the hull parent map. -/
theorem ancestorHullDescendantSources_mono_parent (F : ParentForest V)
    (start : Start ↪ ↥F.leaves) {v w : F.AncestorHull start}
    (hparent : (F.ancestorHullForest start).parent v = some w) :
    F.ancestorHullDescendantSources start v ⊆
      F.ancestorHullDescendantSources start w := by
  intro s hs
  rw [F.mem_ancestorHullDescendantSources] at hs ⊢
  exact hs.tail ((F.ancestorHullParent_eq_some start v w).1 hparent)

/-- Labels of all selected descendant sources at an active hull vertex.
Multiplicity is intentionally forgotten, while every distinct source label is
retained. -/
def ancestorHullDescendantLabels {Label : Type*} [DecidableEq Label]
    (F : ParentForest V) (start : Start ↪ ↥F.leaves) (label : Start → Label)
    (v : F.AncestorHull start) : Finset Label :=
  (F.ancestorHullDescendantSources start v).image label

@[simp] theorem mem_ancestorHullDescendantLabels {Label : Type*}
    [DecidableEq Label] (F : ParentForest V) (start : Start ↪ ↥F.leaves)
    (label : Start → Label) (v : F.AncestorHull start) (x : Label) :
    x ∈ F.ancestorHullDescendantLabels start label v ↔
      ∃ s, Relation.ReflTransGen F.ParentStep (start s).1 v.1 ∧ label s = x := by
  simp [ancestorHullDescendantLabels, ancestorHullDescendantSources]

/-- A branch-excess slot carries the labels of all starts below its branch
vertex, rather than one label selected from an occurrence copy. -/
def ancestorHullMergerSlotDescendantLabels {Label : Type*} [DecidableEq Label]
    (F : ParentForest V) (start : Start ↪ ↥F.leaves) (label : Start → Label)
    (slot : (F.ancestorHullForest start).MergerSlot) : Finset Label :=
  F.ancestorHullDescendantLabels start label slot.1

theorem ancestorHullMergerSlotDescendantLabels_nonempty {Label : Type*}
    [DecidableEq Label] (F : ParentForest V) (start : Start ↪ ↥F.leaves)
    (label : Start → Label)
    (slot : (F.ancestorHullForest start).MergerSlot) :
    (F.ancestorHullMergerSlotDescendantLabels start label slot).Nonempty := by
  obtain ⟨s, hs⟩ := F.ancestorHullDescendantSources_nonempty start slot.1
  exact ⟨label s, Finset.mem_image.mpr ⟨s, hs, rfl⟩⟩

end

end ParentForest

end GridGraphs
