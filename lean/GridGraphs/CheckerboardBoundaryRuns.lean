import GridGraphs.CheckerboardWaste
import GridGraphs.GridBoundaryNonalternation

/-!
# Cyclic checkerboard boundary runs

This module packages the component labels of the two checkerboard star forests
around the boundary of a square grid.  It defines the proposed colorwise run
bounds and proves that their conjunction implies `CheckerboardBoundaryBound`.
The colorwise inequalities themselves are deliberately not asserted here.
-/

namespace GridGraphs

open Finset SimpleGraph

/-- One of the two checkerboard center colors. -/
inductive CheckerboardColor
  | black
  | white
  deriving DecidableEq

/-- Exchange the two checkerboard colors. -/
@[simp] def CheckerboardColor.other : CheckerboardColor → CheckerboardColor
  | .black => .white
  | .white => .black

@[simp] theorem CheckerboardColor.other_other (c : CheckerboardColor) :
    c.other.other = c := by
  cases c <;> rfl

/-- Forced centers of a specified checkerboard color. -/
def checkerboardColorCenters {m n : Nat} (c : CheckerboardColor)
    (F : Finset (GridVertex m n)) : Finset (GridVertex m n) :=
  match c with
  | .black => blackCenters F
  | .white => whiteCenters F

@[simp] theorem checkerboardColorCenters_black {m n : Nat}
    (F : Finset (GridVertex m n)) :
    checkerboardColorCenters .black F = blackCenters F := rfl

@[simp] theorem checkerboardColorCenters_white {m n : Nat}
    (F : Finset (GridVertex m n)) :
    checkerboardColorCenters .white F = whiteCenters F := rfl

/-- The ambient forced graph generated by centers of one color.  All grid
vertices are retained, so vertices outside the stars are isolated components.
-/
def checkerboardColorForcedGraph {m n : Nat} (c : CheckerboardColor)
    (F : Finset (GridVertex m n)) : SimpleGraph (GridVertex m n) :=
  forcedEdgeGraph (gridGraph m n)
    (↑(checkerboardColorCenters c F) : Set (GridVertex m n))

@[simp] theorem checkerboardColorForcedGraph_black {m n : Nat}
    (F : Finset (GridVertex m n)) :
    checkerboardColorForcedGraph .black F =
      forcedEdgeGraph (gridGraph m n)
        (↑(blackCenters F) : Set (GridVertex m n)) := rfl

@[simp] theorem checkerboardColorForcedGraph_white {m n : Nat}
    (F : Finset (GridVertex m n)) :
    checkerboardColorForcedGraph .white F =
      forcedEdgeGraph (gridGraph m n)
        (↑(whiteCenters F) : Set (GridVertex m n)) := rfl

/-- Component label seen at a position of the cyclic grid boundary. -/
noncomputable def checkerboardBoundaryLabel {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n))
    (i : GridBoundaryPosition n n) :
    (checkerboardColorForcedGraph c F).ConnectedComponent :=
  (checkerboardColorForcedGraph c F).connectedComponentMk
    (gridBoundaryVertex hn hn i)

@[simp] theorem checkerboardBoundaryLabel_mem_supp {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n))
    (i : GridBoundaryPosition n n) :
    gridBoundaryVertex hn hn i ∈ (checkerboardBoundaryLabel hn c F i).supp :=
  ConnectedComponent.connectedComponentMk_mem

/-- Boundary positions at which the component label changes on the next
clockwise step, including the final-to-first step. -/
noncomputable def checkerboardBoundaryRunPositions {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n)) :
    Finset (GridBoundaryPosition n n) := by
  classical
  exact Finset.univ.filter fun i =>
    checkerboardBoundaryLabel hn c F i ≠
      checkerboardBoundaryLabel hn c F (gridBoundarySucc hn hn i)

@[simp] theorem mem_checkerboardBoundaryRunPositions_iff {n : Nat}
    (hn : 2 ≤ n) (c : CheckerboardColor)
    (F : Finset (GridVertex n n)) (i : GridBoundaryPosition n n) :
    i ∈ checkerboardBoundaryRunPositions hn c F ↔
      checkerboardBoundaryLabel hn c F i ≠
        checkerboardBoundaryLabel hn c F (gridBoundarySucc hn hn i) := by
  classical
  simp [checkerboardBoundaryRunPositions]

/-- Number of cyclic runs in a checkerboard component-label word. -/
noncomputable def checkerboardBoundaryRunCount {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n)) : Nat :=
  (checkerboardBoundaryRunPositions hn c F).card

@[simp] theorem checkerboardBoundaryRunCount_eq_card {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n)) :
    checkerboardBoundaryRunCount hn c F =
      (checkerboardBoundaryRunPositions hn c F).card := rfl

/-- The component labels of either checkerboard forced graph cannot exhibit
two distinct labels in cyclically alternating positions. -/
theorem checkerboardBoundaryLabelsNonalternating {n : Nat} (hn : 2 ≤ n)
    (c : CheckerboardColor) (F : Finset (GridVertex n n))
    (a b d e : GridBoundaryPosition n n)
    (halt : CyclicallyAlternating (gridBoundaryLength_pos hn hn) a d b e)
    (had : checkerboardBoundaryLabel hn c F a =
      checkerboardBoundaryLabel hn c F d)
    (hbe : checkerboardBoundaryLabel hn c F b =
      checkerboardBoundaryLabel hn c F e) :
    checkerboardBoundaryLabel hn c F a =
      checkerboardBoundaryLabel hn c F b := by
  let G := checkerboardColorForcedGraph c F
  have hnonalt := componentLabelsNonalternating_gridBoundary hn hn G
    (forcedEdgeGraph_le (gridGraph n n)
      (↑(checkerboardColorCenters c F) : Set (GridVertex n n)))
    a b d e halt
  apply hnonalt (checkerboardBoundaryLabel hn c F a)
    (checkerboardBoundaryLabel hn c F b)
  · exact checkerboardBoundaryLabel_mem_supp hn c F a
  · rw [had]
    exact checkerboardBoundaryLabel_mem_supp hn c F d
  · exact checkerboardBoundaryLabel_mem_supp hn c F b
  · rw [hbe]
    exact checkerboardBoundaryLabel_mem_supp hn c F e

/-- The color allowances are `3n/2` each for even `n`; for odd `n`, black gets
`(3n+3)/2` and white gets `(3n-3)/2`. -/
def checkerboardColorAllowance (n : Nat) : CheckerboardColor → Nat
  | .black => 3 * ((n + 1) / 2)
  | .white => 3 * (n / 2)

theorem checkerboardColorAllowance_add (n : Nat) :
    checkerboardColorAllowance n .black +
      checkerboardColorAllowance n .white = 3 * n := by
  have hdiv := Nat.div_add_mod n 2
  have hmod := Nat.mod_lt n (by omega : 0 < 2)
  simp only [checkerboardColorAllowance]
  omega

/-- Number of ambient components in one color's center-forced graph. -/
noncomputable def checkerboardColorComponentCount {n : Nat} (c : CheckerboardColor)
    (F : Finset (GridVertex n n)) : Nat :=
  match c with
  | .black => Fintype.card (forcedEdgeGraph (gridGraph n n)
      (↑(blackCenters F) : Set (GridVertex n n))).ConnectedComponent
  | .white => Fintype.card (forcedEdgeGraph (gridGraph n n)
      (↑(whiteCenters F) : Set (GridVertex n n))).ConnectedComponent

@[simp] theorem checkerboardColorComponentCount_black {n : Nat}
    (F : Finset (GridVertex n n)) :
    checkerboardColorComponentCount .black F =
      Fintype.card (forcedEdgeGraph (gridGraph n n)
        (↑(blackCenters F) : Set (GridVertex n n))).ConnectedComponent := by
  rfl

@[simp] theorem checkerboardColorComponentCount_white {n : Nat}
    (F : Finset (GridVertex n n)) :
    checkerboardColorComponentCount .white F =
      Fintype.card (forcedEdgeGraph (gridGraph n n)
        (↑(whiteCenters F) : Set (GridVertex n n))).ConnectedComponent := by
  rfl

/-- Candidate colorwise run inequality.  It is a proposition, not a theorem:
the geometric argument establishing it remains open. -/
def CheckerboardColorRunBound {n : Nat} (hn : 2 ≤ n)
    (U : Finset (GridVertex n n)) (c : CheckerboardColor) : Prop :=
  let F := (Finset.univ : Finset (GridVertex n n)) \ U
  2 * (boundaryDeficiencySum n n (checkerboardColorCenters c F) +
        (checkerboardColorCenters c U).card + 2) +
      checkerboardBoundaryRunCount hn c F ≤
    2 * (checkerboardColorAllowance n c +
        checkerboardColorComponentCount c F) +
      checkerboardBoundaryRunCount hn c.other F

/-- The black and white candidate run inequalities cancel their run terms and
imply the checkerboard boundary bound. -/
theorem checkerboardBoundaryBound_of_colorRunBounds {n : Nat} (hn : 2 ≤ n)
    (U : Finset (GridVertex n n))
    (hblack : CheckerboardColorRunBound hn U .black)
    (hwhite : CheckerboardColorRunBound hn U .white) :
    CheckerboardBoundaryBound n U := by
  let F := (Finset.univ : Finset (GridVertex n n)) \ U
  have hdef : boundaryDeficiencySum n n (blackCenters F) +
      boundaryDeficiencySum n n (whiteCenters F) =
      boundaryDeficiencySum n n F := by
    unfold boundaryDeficiencySum
    rw [← Finset.sum_union (blackCenters_disjoint_whiteCenters F),
      blackCenters_union_whiteCenters]
  have hUcard : (blackCenters U).card + (whiteCenters U).card = U.card := by
    rw [← Finset.card_union_of_disjoint (blackCenters_disjoint_whiteCenters U),
      blackCenters_union_whiteCenters]
  have hallow := checkerboardColorAllowance_add n
  unfold CheckerboardColorRunBound at hblack hwhite
  dsimp only [checkerboardColorCenters, CheckerboardColor.other] at hblack hwhite
  unfold CheckerboardBoundaryBound checkerboardComponentCount
  dsimp only
  rw [← checkerboardColorComponentCount_black,
    ← checkerboardColorComponentCount_white]
  simp only [F] at hdef ⊢
  omega

end GridGraphs
